---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("posts")).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
); // O(n log n)
---

<Base title="Blog">
  <div class="container">
    <ul>
      {
        posts.map((post, i) => (
          <li class="rise" style={`--i: ${i}`}>
            <a href={`/blog/${post.id}/`}>
              <FormattedDate date={post.data.date} />
              <h2 style={`--vt-name: title-${post.id}`}>{post.data.title}</h2>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .container {
    margin: 0 auto;
    max-width: 1200px;
    width: 100%;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }
  ul {
    margin: 0;
    padding: 0;
  }
  li {
    list-style: none;
    margin-bottom: 1.5rem;
  }
  a {
    color: var(--text);
    display: inline-block;
  }
  h2 {
    margin: 0;
    font-weight: 500;
    width: fit-content;
  }
  h2::after {
    content: " →";
    color: var(--accent);
    opacity: 0;
  }
  a:is(:hover, :focus-visible) h2::after {
    opacity: 1;
  }
  /* Only the clicked title gets a name: named elements skip the .rise entrance */
  a:is(:hover, :focus) h2 {
    view-transition-name: var(--vt-name);
    view-transition-class: title;
  }
  @media (prefers-reduced-motion: no-preference) {
    h2,
    h2::after {
      transition: transform 200ms ease-out, opacity 200ms ease-out;
    }
    a:is(:hover, :focus-visible) h2 {
      transform: translateX(4px);
    }
  }
</style>
