---
import Base from "../layouts/Base.astro";
import Social from "../components/Social.astro";
---

<Base>
  <div class="container">
    <div>
      <h1>Hi, I'm Eder<span class="fancy">.</span></h1>
      <span class="handle">@emunhoz</span>
      <h2>I design user interfaces and engineer digital products.</h2>
      <p class="bio">Designer turned engineer. Now building e-commerce at <a href="https://www.kpn.com/shop/" target="_blank" rel="noopener">KPN</a>, Amsterdam, NL.</p>
      <Social />
    </div>
  </div>
</Base>

<style>
  .container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    padding: 0 1.5rem;
  }
  .container > div {
    max-width: 40rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .container > div > :global(*) {
      animation: rise 400ms ease-out backwards;
    }
    .container > div > :global(:nth-child(2)) {
      animation-delay: 60ms;
    }
    .container > div > :global(:nth-child(3)) {
      animation-delay: 120ms;
    }
    .container > div > :global(:nth-child(4)) {
      animation-delay: 180ms;
    }
    .container > div > :global(:nth-child(5)) {
      animation-delay: 240ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  h1 {
    font-size: 2.5rem;
    margin: 0;
    font-weight: 500;
  }
  h2 {
    margin: 1rem 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.25;
  }
  .bio {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--link);
  }
  .bio a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--link);
    text-underline-offset: 0.2em;
  }
  .bio a:hover {
    text-decoration-color: var(--accent);
  }
  .fancy {
    color: var(--accent);
  }
  .handle {
    display: inline-block;
    margin-top: 0.275em;
    color: var(--link);
    letter-spacing: 0.05em;
  }
  @media (min-width: 769px) {
    h1 {
      font-size: 3rem;
    }
    h2 {
      font-size: 2.25rem;
    }
  }
</style>
