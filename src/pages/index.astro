---
import Base from "../layouts/Base.astro";
import Social from "../components/Social.astro";
---

<Base>
  <div class="container">
    <div>
      <h1>Hi, I'm Eder<span class="fancy">.</span></h1>
      <span class="handle">@emunhoz</span>
      <h2>I design, code, and ship products.</h2>
      <Social />
    </div>
  </div>
</Base>

<style>
  .container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    padding: 0 1.5rem;
  }
  h1 {
    font-size: 2.5rem;
    margin: 0;
    font-weight: 500;
  }
  h2 {
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.25;
  }
  .fancy {
    color: var(--accent);
  }
  .handle {
    display: inline-block;
    margin-top: 0.275em;
    color: var(--link);
    letter-spacing: 0.05em;
  }
  @media (min-width: 769px) {
    h1 {
      font-size: 3rem;
    }
    h2 {
      font-size: 2.25rem;
    }
  }
</style>
