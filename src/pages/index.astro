---
import Base from "../layouts/Base.astro";
import Social from "../components/Social.astro";

const currentWork = {
  isVisible: false,
  label: "Building Elye.app",
  href: "https://elye.app/",
};
---

<Base>
  <div class="container">
    <div>
      {currentWork.isVisible && (
        <a class="pill" href={currentWork.href} data-umami-event="current-work-pill" target="_blank" rel="noopener">
          <span class="dot" aria-hidden="true"></span>
          {currentWork.label}
          <span aria-hidden="true">→</span>
        </a>
      )}
      <h1>Hi, I'm Eder<span class="fancy">.</span></h1>
      <span class="handle">@emunhoz</span>
      <h2>I design user interfaces and engineer digital products.</h2>
      <p class="bio">Designer turned engineer. Now building e-commerce at <a href="https://www.kpn.com/shop/" data-umami-event="kpn-link" target="_blank" rel="noopener">KPN</a>, Amsterdam, NL.</p>
      <Social />
    </div>
  </div>
</Base>

<style>
  .container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    padding: 0 1.5rem;
  }
  .container > div {
    max-width: 40rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .container > div > :global(*) {
      animation: rise 400ms ease-out backwards;
    }
    .container > div > :global(:nth-child(2)) {
      animation-delay: 60ms;
    }
    .container > div > :global(:nth-child(3)) {
      animation-delay: 120ms;
    }
    .container > div > :global(:nth-child(4)) {
      animation-delay: 180ms;
    }
    .container > div > :global(:nth-child(5)) {
      animation-delay: 240ms;
    }
    .container > div > :global(:nth-child(6)) {
      animation-delay: 300ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  h1 {
    font-size: 2.5rem;
    margin: 0;
    font-weight: 500;
  }
  h2 {
    margin: 1rem 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.25;
  }
  .bio {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--link);
  }
  .bio a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--link);
    text-underline-offset: 0.2em;
  }
  .bio a:hover {
    text-decoration-color: var(--accent);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text);
    transition: border-color 0.3s ease;
    position: relative;
  }
  .pill::before {
    content: "";
    position: absolute;
    inset: -6px 0;
  }
  .pill:hover,
  .pill:focus-visible {
    border-color: var(--accent);
    color: var(--text);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  .fancy {
    color: var(--accent);
  }
  .handle {
    display: inline-block;
    margin-top: 0.275em;
    color: var(--link);
    letter-spacing: 0.05em;
  }
  @media (min-width: 769px) {
    h1 {
      font-size: 3rem;
    }
    h2 {
      font-size: 2.25rem;
    }
  }
</style>
