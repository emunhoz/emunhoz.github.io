---
import Base from "../../layouts/Base.astro";
import { getPublishedWork } from "../../lib/work";

const entries = await getPublishedWork();
---

<Base title="Work" description="Selected work: product UI I designed and engineered.">
  <div class="container">
    {entries.length === 0 && <p>Case studies are on their way.</p>}
    <ul>
      {
        entries.map((entry, i) => (
          <li class="rise" style={`--i: ${i}`}>
            <a href={`/work/${entry.id}/`}>
              <span class="meta">{entry.data.role} · {entry.data.year}</span>
              <h2 style={`--vt-name: title-${entry.id}`}>{entry.data.title}</h2>
              <p>{entry.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .container {
    margin: 0 auto;
    max-width: 1200px;
    width: 100%;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }
  ul {
    margin: 0;
    padding: 0;
  }
  li {
    list-style: none;
    margin-bottom: 2rem;
  }
  a {
    color: var(--text);
    display: inline-block;
    max-width: 36rem;
  }
  .meta {
    color: var(--link);
  }
  h2 {
    margin: 0;
    font-weight: 500;
    width: fit-content;
  }
  h2::after {
    content: " →";
    color: var(--accent);
    opacity: 0;
  }
  a:is(:hover, :focus-visible) h2::after {
    opacity: 1;
  }
  /* Only the clicked title gets a name: named elements skip the .rise entrance */
  a:is(:hover, :focus) h2 {
    view-transition-name: var(--vt-name);
    view-transition-class: title;
  }
  @media (prefers-reduced-motion: no-preference) {
    h2,
    h2::after {
      transition: transform 200ms ease-out, opacity 200ms ease-out;
    }
    a:is(:hover, :focus-visible) h2 {
      transform: translateX(4px);
    }
  }
  p {
    margin: 0.25rem 0 0;
    color: var(--link);
    line-height: 1.5;
  }
</style>
