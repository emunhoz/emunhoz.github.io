---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPublishedWork, type WorkEntry } from "../../lib/work";

export async function getStaticPaths() {
  const entries = await getPublishedWork();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: WorkEntry };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <div class="reading-progress" aria-hidden="true"></div>
  <div class="container">
    <article>
      <header>
        <h1 class="rise">{entry.data.title}</h1>
        <span class="meta rise" style="--i: 1">{entry.data.role} · {entry.data.year}</span>
        {entry.data.outcome && <p class="outcome rise" style="--i: 2">{entry.data.outcome}</p>}
      </header>
      <div class="content prose rise" style="--i: 3"><Content /></div>
    </article>
    <footer>
      {entry.data.link && <a href={entry.data.link} target="_blank" rel="noopener" data-umami-event="visit-project" data-umami-event-project={entry.id}>Visit project</a>}
    </footer>
  </div>
</Base>

<style>
  .container {
    max-width: 36rem;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: 2.25rem;
    font-weight: 500;
  }
  .meta {
    color: var(--link);
  }
  .outcome {
    margin: 1rem 0 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.6vw, 1.1875rem);
    line-height: 1.6;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
  }
  footer {
    margin-top: 3rem;
  }
  footer a {
    color: var(--accent);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .content :global(:is(img, h2, pre, blockquote)) {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
</style>
