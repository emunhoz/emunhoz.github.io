---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import CommandPalette from "../components/CommandPalette.astro";
import SpecsOverlay from "../components/SpecsOverlay.astro";
import { latestVersion } from "../lib/changelog";

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = "Eder Munhoz";
const UMAMI_WEBSITE_ID = "1ddc9403-5910-4988-b46b-24f31dd36055";
const DEFAULT_DESCRIPTION = "Eder Munhoz dos Santos — Design Engineer based in Amsterdam.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — Design Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Runs before paint so a saved theme never flashes the OS theme first.
      try {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111" media="(prefers-color-scheme: dark)" />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={UMAMI_WEBSITE_ID}
          data-domains="emunhoz.github.io"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="root">
      <Nav />
      <main id="main"><slot /></main>
    </div>
    <footer>
      <span>© {new Date().getFullYear()} {SITE_NAME}</span>
      <a href="/system/">How this site is built <span class="arrow" aria-hidden="true">→</span></a>
      <button class="footer-button palette-hint" type="button" aria-label="Open command palette" onclick="document.dispatchEvent(new Event('palette:open'))"><kbd>⌘K</kbd></button>
      <button class="footer-button theme-toggle" type="button" aria-label="Color theme: auto">Theme: auto</button>
      <a href="/changelog/">v{latestVersion()}</a>
    </footer>
    <CommandPalette />
    <SpecsOverlay />
    <script>
      const THEMES = ["auto", "light", "dark"] as const;
      type Theme = (typeof THEMES)[number];
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

      function currentTheme(): Theme {
        const theme = document.documentElement.dataset.theme;
        return theme === "light" || theme === "dark" ? theme : "auto";
      }

      function render(theme: Theme): void {
        if (!button) return;
        button.textContent = `Theme: ${theme}`;
        button.setAttribute("aria-label", `Color theme: ${theme}`);
      }

      function applyTheme(theme: Theme): void {
        const root = document.documentElement;
        try {
          if (theme === "auto") localStorage.removeItem("theme");
          else localStorage.setItem("theme", theme);
        } catch {}
        if (theme === "auto") delete root.dataset.theme;
        else root.dataset.theme = theme;
        render(theme);
      }

      render(currentTheme());
      button?.addEventListener("click", () => {
        const next = THEMES[(THEMES.indexOf(currentTheme()) + 1) % THEMES.length];
        applyTheme(next);
      });
      document.addEventListener("theme:cycle", () => button?.click());
    </script>
  </body>
</html>

<style>
  .root {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
    padding: 4rem 0 2rem;
    box-sizing: border-box;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    padding: 1.5rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    font-size: 0.875rem;
    color: var(--link);
  }
  /* inline-block keeps the link's underline off the separator */
  footer > * + *::before {
    content: "·";
    display: inline-block;
    margin-right: 1rem;
  }
  @media (max-width: 480px) {
    footer {
      flex-direction: column;
      align-items: center;
    }
    footer > * + *::before {
      content: none;
    }
  }
  footer a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  main {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
  }
  @media (min-width: 769px) {
    .root {
      flex-direction: row;
    }
  }
</style>
