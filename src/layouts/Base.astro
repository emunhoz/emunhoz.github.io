---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = "Eder Munhoz";
const UMAMI_WEBSITE_ID = "1ddc9403-5910-4988-b46b-24f31dd36055";
const DEFAULT_DESCRIPTION = "Eder Munhoz dos Santos — Design Engineer based in Amsterdam.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — Design Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500&family=Ubuntu+Mono&display=swap"
      rel="stylesheet"
    />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={UMAMI_WEBSITE_ID}
          data-domains="emunhoz.github.io"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="root">
      <Nav />
      <main id="main"><slot /></main>
    </div>
    <footer>
      <span>© {new Date().getFullYear()} {SITE_NAME}</span>
      <a href="/system/">How this site is built <span class="arrow" aria-hidden="true">→</span></a>
    </footer>
  </body>
</html>

<style>
  .root {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
    padding: 4rem 0 2rem;
    box-sizing: border-box;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    padding: 1.5rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    font-size: 0.8rem;
    color: var(--link);
  }
  /* inline-block keeps the link's underline off the separator */
  footer > * + *::before {
    content: "·";
    display: inline-block;
    margin-right: 1rem;
  }
  @media (max-width: 480px) {
    footer {
      flex-direction: column;
      align-items: center;
    }
    footer > * + *::before {
      content: none;
    }
  }
  footer a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  main {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
  }
  @media (min-width: 769px) {
    .root {
      flex-direction: row;
    }
  }
</style>
