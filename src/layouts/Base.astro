---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = "Eder Munhoz";
const DEFAULT_DESCRIPTION = "Eder Munhoz dos Santos — Design Engineer based in Amsterdam.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — Design Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500&family=Ubuntu+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="root">
      <Nav />
      <main id="main"><slot /></main>
    </div>
    <footer>© {new Date().getFullYear()} | All rights reserved. | <a href="/system/">How this site is built</a></footer>
  </body>
</html>

<style>
  .root {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
    padding: 4rem 0 2rem;
    box-sizing: border-box;
  }
  footer {
    padding: 1.5rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    text-align: center;
    font-size: 0.8rem;
    color: var(--link);
  }
  footer a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  main {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
  }
  @media (min-width: 769px) {
    .root {
      flex-direction: row;
    }
  }
</style>
