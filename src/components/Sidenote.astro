<span class="sidenote-ref"><sup class="sidenote-mark" aria-hidden="true"></sup><small class="sidenote"><slot /></small></span>

<style>
  .sidenote-ref {
    counter-increment: sidenote;
  }
  .sidenote-mark {
    line-height: 0;
  }
  .sidenote-mark::after {
    content: counter(sidenote);
    color: var(--text);
  }
  .sidenote {
    display: block;
    margin: 0.5rem 0 0.5rem 1rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--accent);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--link);
  }
  .sidenote::before {
    content: counter(sidenote) " ";
    color: var(--text);
  }
  /* 72rem leaves room for the 36rem column plus a 14rem note on each side */
  @supports (anchor-name: --sn) and (anchor-scope: --sn) {
    @media (min-width: 72rem) {
      .sidenote-ref {
        anchor-scope: --sn;
      }
      .sidenote-mark {
        anchor-name: --sn;
      }
      .sidenote {
        position: absolute;
        position-anchor: --sn;
        top: anchor(top);
        left: calc(50% + 20rem);
        width: 14rem;
        margin: 0;
      }
    }
  }
</style>
