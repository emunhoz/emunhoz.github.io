---
import ThemeSwitch from "./ThemeSwitch.astro";

const LINKS = [
  { href: "/", label: "home" },
  { href: "/work/", label: "work" },
  { href: "/blog/", label: "blog" },
  { href: "/lab/", label: "lab" },
];

const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<nav>
  <button class="burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
    <span class="meat meat-1"></span>
    <span class="meat meat-2"></span>
    <span class="meat meat-3"></span>
  </button>
  <div class="container">
    <ul id="nav-links">
      {
        LINKS.map(({ href, label }, i) => (
          <li style={`--i: ${i}`}>
            <a href={href} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
      <li class="menu-control menu-control-first" style={`--i: ${LINKS.length}`}>
        <button class="palette-hint" type="button">search</button>
      </li>
      <li class="menu-control" style={`--i: ${LINKS.length + 1}`}>
        <ThemeSwitch />
      </li>
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector("nav");
  const burger = nav?.querySelector<HTMLButtonElement>(".burger");
  burger?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open") ?? false;
    burger.setAttribute("aria-expanded", String(isOpen));
  });

</script>

<style>
  .burger {
    position: fixed;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    cursor: pointer;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    right: 1.25rem;
    z-index: 2;
    background-color: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .meat {
    position: absolute;
    width: 28px;
    height: 2px;
    background: var(--text);
    top: calc(50% - 2px / 2);
    left: calc(50% - 28px / 2);
    transition: all 150ms ease-in;
  }
  .meat-1 {
    transform: translateY(-10px);
  }
  .meat-2 {
    width: calc(28px - 6px);
    left: calc(50% - 28px / 2 + 6px);
  }
  .meat-3 {
    transform: translateY(10px);
  }
  .open .meat-1 {
    transform: rotate(45deg);
  }
  .open .meat-2 {
    opacity: 0;
  }
  .open .meat-3 {
    transform: rotate(-45deg);
  }

  .container {
    width: 0;
  }
  ul {
    visibility: hidden;
    opacity: 0;
    width: 100%;
    height: 100vh;
    text-align: right;
    list-style: none;
    margin: 0;
    padding: 0;
    position: fixed;
    top: 0;
    left: 0;
    background-color: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 1;
    transform: translateY(100%);
    transition: opacity 200ms;
  }
  .open ul {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  li {
    margin-bottom: 1.75rem;
    font-size: 2rem;
    padding: 0 1.5rem 0 0;
  }
  li:last-child {
    margin-bottom: 0;
  }
  a.active {
    position: relative;
    color: var(--text);
  }
  /* absolute so the dot never shifts the right-aligned label */
  a.active::after {
    content: ".";
    position: absolute;
    left: 100%;
    color: var(--accent);
  }
  @media (max-width: 768px) and (prefers-reduced-motion: no-preference) {
    .open li {
      animation: rise 300ms ease-out backwards;
      animation-delay: calc(var(--i) * 50ms + 80ms);
    }
  }
  .menu-control {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .menu-control-first {
    margin-top: 3rem;
  }
  .palette-hint {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--link);
    cursor: pointer;
  }
  @media (min-width: 769px) {
    .menu-control {
      display: none;
    }
    .burger {
      display: none;
    }
    .container {
      width: 7rem;
      display: block;
    }
    ul {
      visibility: visible;
      opacity: 1;
      width: 7rem;
      height: auto;
      top: auto;
      left: auto;
      display: block;
      transform: translateY(0);
      background-color: transparent;
    }
    li {
      font-size: 1.125rem;
      padding: 0;
    }
  }
</style>
